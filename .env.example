# Copy to .env.local and fill in. Never commit real secrets — .env.local is gitignored.

# --- Database -----------------------------------------------------------------
# Two drivers, chosen by DATABASE_DRIVER:
#
#  - Production / shared (default): Neon Postgres over the HTTP serverless driver.
#    Create a project at https://neon.tech (or via the Vercel Marketplace) and
#    paste the pooled connection string into DATABASE_URL.
#  - Local dev (lightweight): set DATABASE_DRIVER=pglite for an in-process WASM
#    Postgres that persists to ./.pglite — no server, no Docker. DATABASE_URL is
#    then ignored. Apply migrations with `npm run db:local` (not drizzle-kit,
#    which needs a wire-protocol server). Override the folder with PGLITE_DATA_DIR.
#
# Local data profiles (you usually don't set these here — the npm scripts do):
#  - `npm run dev:real` → PGLITE_DATA_DIR=~/.freedom/real.pglite (OUTSIDE the repo,
#    so your real data can't be committed/rm'd/uploaded). Run `npm run db:real` once first.
#  - `npm run dev:demo` → PGLITE_DATA_DIR=./.pglite-demo + FREEDOM_PROFILE=demo (amber
#    "DEMO DATA" banner). Rebuild the sample data any time with `npm run seed:demo`.
# See src/db/CLAUDE.md → "Local data profiles".
#
# DATABASE_DRIVER="pglite"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Secret used to encrypt session data. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI (local):
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated allowlist of emails permitted to sign in. Anyone not listed is
# rejected before an account is created. Leave empty to allow any Google account
# (dev only) — always set this in shared/deployed environments.
AUTH_ALLOWED_EMAILS=""

# Local-development convenience: set to "true" to SKIP Google sign-in and run as a
# fixed local user. Off by default (real auth in every environment). Ignored when
# NODE_ENV=production — the bypass can never disable auth on a deployed instance.
# AUTH_DEV_BYPASS="true"
